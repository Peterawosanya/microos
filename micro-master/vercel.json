{
  "version": 2,
  "builds": [
    {
      "src": "api/forwardToZapier.ts",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/forwardToZapier",
      "dest": "/api/forwardToZapier.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}
